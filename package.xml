<?xml version="1.0"?>
<package format="3">
  <name>lio_livox</name>
  <version>0.0.1</version>

  <description>
    LIO-Livox (ROS 2 Foxy port)
  </description>

  <maintainer email="dev@livoxtech.com">livox</maintainer>
  <license>BSD</license>
  <author email="dev@livoxtech.com">livox</author>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 runtime/build dependencies -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_conversions</depend>

  <!-- Livox ROS 2 driver (expects livox_ros_driver2) -->
  <depend>livox_ros_driver2</depend>

  <!-- System/third-party libraries (resolved via rosdep) -->
  <depend>eigen3_cmake_module</depend>
  <depend>Eigen3</depend>
  <depend>PCL</depend>
  <depend>ament_index_cpp</depend>
  <depend>OpenCV</depend>
  <depend>ceres-solver</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
